# ============================================================================
# Qiltrack AI - Environment Configuration
# ============================================================================
# 复制此文件为 .env.local，填入实际值后运行 npm run dev
#
# ⚠️  重要提示：应用启动时会自动验证必需的环境变量
#    如果配置不正确，服务器将无法启动并显示详细错误信息
# ============================================================================

# ============================================================================
# 品牌配置
# ============================================================================
NEXT_PUBLIC_BRAND_NAME="Qiltrack AI"
NEXT_PUBLIC_BRAND_SHORT="Qiltrack"
NEXT_PUBLIC_DOMAIN="qiltrack.com"
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN="qiltrack.com"

# ============================================================================
# 数据源 - Finnhub（股票行情）
# ============================================================================
# 必需 - 用于获取股票市场数据
FINNHUB_API_KEY=your_finnhub_key

# ============================================================================
# LLM 供应商（至少配置其一）
# ============================================================================
# 必需 - 至少配置 Helicone 或 OpenRouter 其中之一
# 优先级 1：Helicone（OpenAI 兼容）
HELICONE_API_KEY=sk-helicone-your-key
HELICONE_MODEL=gpt-4o-mini

# 优先级 2：OpenRouter（备选）
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# 可选 - Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_SAMPLING_RATE=1.0

# ============================================================================
# Supabase configuration (hosted instance)
# ============================================================================
# Required - fetch from Dashboard -> Settings -> API for project inmtounwqcjwsxkfnsfd
# Example: https://inmtounwqcjwsxkfnsfd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://inmtounwqcjwsxkfnsfd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hT6o-oVeTgfmMeWbP7fwaA_ZtBQEeGV
# Server-side secret: get the production service role key from vault/Supabase dashboard; never use demo keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Storage bucket config (dev/prod share the same bucket name)
SUPABASE_STORAGE_REPORT_BUCKET=report-assets

# ============================================================================
# Auth Redirect Base URL (必须配置，用于 OAuth/Magic Link 回调)
# ============================================================================
# 用途：Supabase 认证回调的基础 URL
# - OAuth 登录 (Google, GitHub 等)
# - Magic Link 邮箱登录
# - 密码重置链接
#
# 配置说明：
# - 开发环境：http://localhost:3000 或 http://192.168.8.40:3000 (局域网访问)
# - 生产环境：https://your-domain.com (必须使用 HTTPS)
#
# ⚠️ 重要：配置后需在 Supabase Dashboard 添加回调 URL
#    运行检查脚本查看需要添加的 URL：node scripts/check-supabase-redirects.js
#    Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# 测试与开发配置
# ============================================================================
# 测试报告生成时使用的令牌（绕过登录，仅限开发）
TEST_REPORT_TOKEN=test-token-12345

# ============================================================================
# NextAuth 配置
# ============================================================================
# 必需 - 用于用户认证和会话管理
NEXTAUTH_URL=http://192.168.8.40:3000
# 必须至少 32 字符，使用 openssl rand -base64 32 生成
NEXTAUTH_SECRET=replace-with-random-string-from-openssl-rand-base64-32

# ============================================================================
# Stripe 支付配置（可选，支付功能）
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_BASIC=price_basic_plan_id
STRIPE_PRICE_PRO=price_pro_plan_id
NEXT_PUBLIC_FEATURE_PAYWALL=false

# ============================================================================
# 邮件配置（可选，邮件提醒）
# ============================================================================
EMAIL_SERVER=smtp://user:pass@mailtrap.io:2525
EMAIL_FROM="Qiltrack AI <no-reply@qiltrack.com>"

# ============================================================================
# Upstash Redis 配置（API 限流）
# ============================================================================
# 可选 - 从 https://upstash.com 获取
# 用于实现：
# - 报告生成限流: 每用户每分钟 5 次
# - 全局 API 限流: 每 IP 每秒 20 次
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================================================
# 环境变量
# ============================================================================
NODE_ENV=development

# ============================================================================
# 功能开关
# ============================================================================
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# ============================================================================
# Cloudflare Turnstile 配置（机器人防护）
# ============================================================================
# 从 Cloudflare Dashboard 获取: https://dash.cloudflare.com/?to=/:account/turnstile
# 三种模式可选：托管模式（推荐）、非交互式模式、不可见模式
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
