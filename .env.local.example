# ============================================================================
# Investor AI - Environment Configuration
# ============================================================================
# 复制此文件为 .env.local，填入实际值后运行 npm run dev

# ============================================================================
# 数据源 - Finnhub（股票行情）
# ============================================================================
FINNHUB_API_KEY=your_finnhub_key

# ============================================================================
# LLM 供应商（至少配置其一）
# ============================================================================
# 优先级 1：Helicone（OpenAI 兼容）
HELICONE_API_KEY=sk-helicone-your-key
HELICONE_MODEL=gpt-4o-mini

# 优先级 2：OpenRouter（备选）
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_SAMPLING_RATE=1.0

# ============================================================================
# Supabase 配置（Hosted 实例）
# ============================================================================
# 从 Dashboard → Settings → API 获取
# URL 示例：https://xyzabc.supabase.co （注意：生产环境不用 localhost）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 存储桶配置（开发与生产使用私有桶）
SUPABASE_STORAGE_REPORT_BUCKET=report-assets

# 站点 URL（可选，仅在需要固定重定向 URL 时设置）
# 默认：自动使用当前访问的 URL（支持多 worktree 不同端口）
# 仅在生产环境或需要跨 worktree 共享 session 时才需要设置
# 开发环境示例：http://localhost:3002
# 生产环境示例：https://your-domain.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# 测试与开发配置
# ============================================================================
# 测试报告生成时使用的令牌（绕过登录，仅限开发）
TEST_REPORT_TOKEN=test-token-12345

# ============================================================================
# NextAuth 配置
# ============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-string-from-openssl-rand-base64-32

# ============================================================================
# Stripe 支付配置（可选，支付功能）
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_FEATURE_PAYWALL=false

# ============================================================================
# 邮件配置（可选，邮件提醒）
# ============================================================================
EMAIL_SERVER=smtp://user:pass@mailtrap.io:2525
EMAIL_FROM="Investor AI <no-reply@investor.ai>"

# ============================================================================
# 环境变量
# ============================================================================
NODE_ENV=development

# ============================================================================
# 功能开关
# ============================================================================
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
