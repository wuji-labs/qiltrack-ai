{
  "name": "investor-ai",
  "version": "0.1.0",
  "private": true,
  "_comment_port_warning": "⚠️ DO NOT modify 'dev' script! Port is managed via .env.local. See docs/AI_INSTRUCTIONS.md",
  "scripts": {
    "dev": "next dev",
    "dev:start": "bash scripts/dev-start.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest --environment jsdom --pool=forks",
    "test:ci": "cross-env CI=true vitest --environment jsdom --pool=forks run",
    "helicone:sync-models": "node scripts/update-helicone-models.js",
    "env:check": "node scripts/check-env.js",
    "worktree:setup-port": "node scripts/setup-worktree-port.js",
    "backup:db": "pwsh -File scripts/backup-database.ps1",
    "backup:db:bash": "bash scripts/backup-database.sh",
    "test:backup": "bash scripts/test-backup-scripts.sh",
    "pr:ready": "npm run lint && npm run test && echo '✅代码已准备好提交 PR'"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.1",
    "@refinedev/core": "^5.0.6",
    "@refinedev/nextjs-router": "^7.0.4",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.46.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.7",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "esbuild": "^0.27.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.3",
    "langfuse": "^2.0.0",
    "next": "16.0.3",
    "nodemailer": "^7.0.10",
    "openai": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.67.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "jsdom": "^26.0.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
