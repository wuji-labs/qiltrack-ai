{
  "name": "qiltrack-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:safe": "node scripts/dev-safe.js",
    "dev:stop": "node scripts/dev-stop.js",
    "dev:restart": "node scripts/dev-restart.js",
    "dev:start": "bash scripts/dev-start.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest --environment jsdom --pool=forks",
    "test:ci": "cross-env CI=true vitest --environment jsdom --pool=forks run",
    "helicone:sync-models": "node scripts/update-helicone-models.js",
    "env:check": "node scripts/check-env.js",
    "worktree:setup-port": "node scripts/setup-worktree-port.js",
    "backup:db": "pwsh -File scripts/backup-database.ps1",
    "backup:db:bash": "bash scripts/backup-database.sh",
    "test:backup": "bash scripts/test-backup-scripts.sh",
    "pr:ready": "npm run lint && npm run test && echo '✅代码已准备好提交 PR'",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "db:types:optional": "node scripts/ensure-db-types.js",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:push:dev": "supabase link --project-ref nkqwtejxnghotzuazslk && supabase db push",
    "db:push:prod": "supabase link --project-ref inmtounwqcjwsxkfnsfd && supabase db push",
    "postdb:reset": "npm run db:types",
    "pretest": "npm run db:types:optional",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.1",
    "@refinedev/core": "^5.0.6",
    "@refinedev/nextjs-router": "^7.0.4",
    "@sentry/nextjs": "^10.27.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.46.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.7",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "esbuild": "^0.27.0",
    "file-saver": "^2.0.5",
    "inngest": "^3.46.0",
    "jspdf": "^3.0.3",
    "langfuse": "^2.0.0",
    "lucide-react": "^0.556.0",
    "next": "^16.0.7",
    "nodemailer": "^7.0.10",
    "openai": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-is": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "jsdom": "^26.0.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}
